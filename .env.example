# Base URL of a local Robinhood Liquidity Terminal (trailing slash optional).
STOCK_AGENT_TERMINAL_BASE_URL=http://127.0.0.1:3000

# HTTP timeout for Terminal requests (milliseconds).
STOCK_AGENT_HTTP_TIMEOUT_MS=15000

# Max assets to drill with expensive execution endpoints.
STOCK_AGENT_DRILLDOWN_LIMIT=5

# Mark retrieved payloads STALE when older than this many milliseconds.
STOCK_AGENT_STALE_AFTER_MS=60000
